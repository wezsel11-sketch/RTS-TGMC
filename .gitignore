# Build output: scratch clones, .NET SDK, staging. The finished game is committed under game/ (see the end of this file).
build/

# TGMC-derived or extracted art and audio, outside game/. game/ is the one place they are committed.
*.dmi
*.png
*.gif
*.jpg
*.ogg
*.wav
*.mp3
*.aud
*.shp
*.tem
*.mix
*.oramap
*.zip
*.pal

# Extracted or converted sprite and sound sets from anywhere.
extracted/
converted/

# OpenRA engine checkout and its build output, if they sit inside this tree.
OpenRA/
openra/
bin/
obj/
*.pdb
*.deps.json
*.runtimeconfig.json

# Python and editor noise.
__pycache__/
*.pyc
.venv/
.vscode/
.idea/
.DS_Store

# The ready-to-run game. This is a private repo for personal use, so the converted TGMC art/sound
# and the OpenRA binaries under game/ are committed on purpose. These lines must stay last: they
# re-include the files the patterns above would otherwise ignore (.png, .ogg, .deps.json, ...).
!game/
!game/**
# Portable settings, logs, replays and screenshots. PLAY.cmd and OpenRA write here.
game/Support/*
!game/Support/.gitkeep
