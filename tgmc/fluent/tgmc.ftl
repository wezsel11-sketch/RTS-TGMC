actor-resin-turret =
    .name = Resin Turret
    .description = Spits acid at anything that comes near. Needs an Evolution Tower. Place it near a Drone or the Queen.
actor-resin-silo =
    .name = Resin Silo
    .description = A second hive: trains xenos and brings in a little requisition. Place it near the Queen.
actor-mini-silo =
    .name = Mini Silo
    .description = Trains xenos and brings in a little requisition. Place it near the Queen.
actor-medic =
    .name = TGMC Corpsman
    .description = Patches up squadmates. Costs 120 requisition.
actor-engineer =
    .name = TGMC Engineer
    .description = Builds marine structures within a few cells of itself, and repairs them. Costs 130 requisition.
actor-sentry-turret =
    .name = Sentry Turret
    .description = Automatic gun emplacement. Needs an Armory. Place it near an Engineer.
actor-cryo-pod =
    .name = Cryo Pod
    .description = Trains marines. Place it near an Engineer.
actor-vendor =
    .name = Marine Vendor
    .description = Trains marines and brings in a little requisition. Place it near an Engineer.
actor-rifleman =
    .name = TGMC Rifleman
    .description = Standard squad rifleman. Costs 100 requisition.
actor-warrior =
    .name = Xeno Warrior
    .description = Heavy melee slam that hits everything around it. Needs a Maturity Tower. Costs 200 requisition.
actor-smartgunner =
    .name = TGMC Smartgunner
    .description = Rapid, spread fire at short range. Needs an Armory. Costs 200 requisition.
actor-grenadier =
    .name = TGMC Grenadier
    .description = Lobs grenades that splash over a wide area. Needs an Ordnance Depot. Costs 180 requisition.
actor-queen =
    .name = Xeno Queen
    .description = Builds every hive structure, including the towers and silos, within a few cells of herself. Only one. Needs a Resin Silo. Costs 400 requisition.
actor-miner =
    .name = Miner
    .description = Mines supplies: steady requisition income. Place it near an Engineer. Costs 150 requisition.
actor-cade =
    .name = Cade
    .description = Cheap barricade. Place one end, then the other, to build a line. Place it near an Engineer.
actor-armory =
    .name = Armory
    .description = Unlocks the Smartgunner and the Sentry Turret. Place it near an Engineer. Costs 300 requisition.
actor-ordnance-depot =
    .name = Ordnance Depot
    .description = Unlocks the Grenadier. Needs an Armory. Place it near an Engineer. Costs 400 requisition.
actor-weed-node =
    .name = Weed Node
    .description = Spreads weeds that feed the hive: steady requisition income. Place it near a Drone or the Queen. Costs 120 requisition.
actor-resin-wall =
    .name = Resin Wall
    .description = Cheap resin barrier. Place one end, then the other, to build a line. Place it near a Drone or the Queen.
actor-evolution-tower =
    .name = Evolution Tower
    .description = Unlocks the Hunter, the Sentinel and the Resin Turret. Place it near the Queen. Costs 300 requisition.
actor-maturity-tower =
    .name = Maturity Tower
    .description = Unlocks the Warrior. Needs an Evolution Tower. Place it near the Queen. Costs 450 requisition.

support-queen-screech =
    .name = Screech
    .description = The Queen roars. Marines within five cells are slowed and fire half as fast for seven seconds.
support-flare =
    .name = Flare
    .description = Lights up the ground round the target for twelve seconds, so you can see what is out there. Needs an Armory.
actor-crusher =
    .name = Xeno Crusher
    .description = Huge and heavily armoured: rifles barely hurt it, and it tramples marines underfoot. Slow. Needs a Maturity Tower. Costs 350 requisition.
actor-boiler =
    .name = Xeno Boiler
    .description = Artillery. Lobs acid a long way, strong against armour, but cannot hit what is close and dies fast. Needs a Maturity Tower. Costs 300 requisition.
actor-mech =
    .name = Assault Mech
    .description = Heavily armoured walker: a cannon for armour and structures, a machine gun for infantry. Engineers repair it. Needs a Mech Bay. Costs 450 requisition.
actor-mortar-crew =
    .name = Mortar Crew
    .description = Artillery. Lobs shells a long way with a wide splash, but cannot hit what is close. Needs an Ordnance Depot. Costs 220 requisition.
actor-mech-bay =
    .name = Mech Bay
    .description = Unlocks the Assault Mech. Needs an Ordnance Depot. Place it near an Engineer. Costs 450 requisition.
actor-research-lab =
    .name = Research Lab
    .description = Better armour and ammunition for every marine, and the Orbital Strike. Needs an Armory. Place it near an Engineer. Costs 400 requisition.
actor-hive-core =
    .name = Hive Core
    .description = Tougher, faster xenos across the hive. Needs an Evolution Tower. Costs 400 requisition.
support-orbital =
    .name = Orbital Strike
    .description = Calls down a heavy blast on the target a moment after it is marked. Needs a Research Lab. Aim it at what you can see.
