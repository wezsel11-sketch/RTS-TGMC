support-cure =
    .name = Psychic Cure
    .description = Heals every xeno in a nine by nine cell area over ten seconds. Granted by the Evolution Tower. Recharges in one minute and a half.
support-burrowed =
    .name = Call of the Burrowed
    .description = Three runners and two hunters burst out of the ground around the spot you pick. Granted by the Evolution Tower. Recharges in two minutes and a half.
support-rage =
    .name = Hive Rage
    .description = Xenos in a nine by nine cell area hit 35 percent harder and run 30 percent faster for twelve seconds. Granted by the Maturity Tower. Recharges in two minutes.
actor-tunnel =
    .name = Hive Tunnel
    .description = A tunnel mouth. The first two you build are paired: right-click one with a xeno and it comes out of the other. Needs an Evolution Tower. Costs 100 requisition.

actor-scout =
    .name = Jaeger Scout
    .description = Light Jaeger exoskeleton and an SMG: fast and fragile, and sees further than other marines. Costs 90 requisition.
actor-skirmisher =
    .name = Jaeger Skirmisher
    .description = Light Jaeger exoskeleton and a shotgun: quick and deadly up close. Needs an Armory. Costs 130 requisition.
actor-trooper =
    .name = Jaeger Trooper
    .description = Medium Jaeger exoskeleton and a rifle: takes 12 percent less damage than a rifleman and carries more. Needs an Armory. Costs 140 requisition.
actor-ranger =
    .name = Jaeger Ranger
    .description = Medium Jaeger exoskeleton and an M412: longer reach, sees 12 cells and takes 8 percent less damage. Needs an Armory. Costs 170 requisition.
actor-assault =
    .name = Jaeger Assault
    .description = Heavy Jaeger exoskeleton and a carbine: slow, but shrugs off claws and acid like the other heavy marines. Needs an Ordnance Depot. Costs 280 requisition.

