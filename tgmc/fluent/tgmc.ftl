actor-hunter =
    .name = Xeno Hunter
    .description = Tough melee skirmisher. Needs an Evolution Tower. Costs 90 requisition.
actor-sentinel =
    .name = Xeno Sentinel
    .description = Spits acid from range. Needs an Evolution Tower. Costs 110 requisition.
actor-drone =
    .name = Xeno Drone
    .description = Mends hive structures and builds minor ones: weed nodes, resin walls, turrets. Costs 60 requisition.
bot-skirmish-ai =
    .name = Skirmish AI
actor-runner =
    .name = Xeno Runner
    .description = Fast, fragile melee harasser. Costs 50 requisition.
tileset-tgmc = TGMC test ground
hud-header = TGMC // COMMAND
